<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Pilgrim" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Night launch theme: dark-parchment canvas. @color/parchment
         resolves to the night value (values-night/colors.xml). -->
    <style name="Theme.Pilgrim.Splash" parent="Theme.Pilgrim">
        <item name="android:windowBackground">@color/parchment</item>
    </style>
</resources>

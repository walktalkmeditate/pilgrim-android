<?xml version="1.0" encoding="utf-8"?>
<!--
  FileProvider roots for files Pilgrim shares via ACTION_SEND.

  - etegami/         (Stage 7-D) Shared etegami PNG postcards. Swept by
                     EtegamiCacheSweeper after 24h; Android also
                     auto-clears cacheDir on storage pressure.
  - recordings_export/ (Stage 10-G) Voice recordings ZIP exports
                     produced from Settings → Data → Export Recordings.
                     No app-side sweeper; the OS clears cacheDir on
                     storage pressure.
  - pilgrim_export/  (Stage 10-I) `.pilgrim` walks archives produced
                     from Settings → Data → Export My Data. Contains
                     manifest.json + walks/<uuid>.json + schema.json
                     + optional photos/ (when user opts in). Same
                     OS-clears-on-pressure lifecycle.
  - seals/           Goshuin seal PNGs produced by
                     SealShareBitmapWriter for the post-walk share
                     button. Subpath `seals/share/seal-<uuid>.png`.
                     Without this entry, FileProvider.getUriForFile
                     throws IllegalArgumentException and the share
                     intent silently no-ops.
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path name="etegami_cache" path="etegami/" />
    <cache-path name="recordings_export" path="recordings_export/" />
    <cache-path name="pilgrim_export" path="pilgrim_export/" />
    <cache-path name="seals_cache" path="seals/" />
    <cache-path name="journey_editor_saves" path="journey-editor-saves/" />
</paths>

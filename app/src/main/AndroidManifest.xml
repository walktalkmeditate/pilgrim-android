<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- ACCESS_BACKGROUND_LOCATION is intentionally NOT declared: our
         foreground service with foregroundServiceType=location covers the
         entire walk lifecycle, so we never read location from a pure
         background state. Declaring it would trigger Play Store's
         enhanced review process for no gain. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- Runtime mic permission for voice recording during walks.
         Requested just-in-time at record-button tap (see Stage 2-C),
         not front-loaded into onboarding. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Required to launch the battery-optimization exemption prompt directly
         via ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS. Justified by our
         foreground-service-with-ongoing-notification location tracking. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Stage 12-C: bell-coupled haptic. BellPlayer.fireMediumImpact uses
         VibrationEffect.Composition (API 30+) or createOneShot fallback;
         Vibrator.vibrate requires this permission. Without it, calls
         throw SecurityException — wrapped in try/catch in BellPlayer
         so the audio still plays, but haptic silently fails on every
         device. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Mapbox tile downloads. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Stage 7-D: save-etegami-to-Photos legacy write path. On API 29+
         MediaStore scoped-storage insert doesn't need this permission;
         `maxSdkVersion=28` scopes the grant to devices that actually
         need it and avoids Play Store's enhanced-storage review. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Photo Reliquary: read photos taken along a walk so they can be
         pinned to the route (iOS-parity photo-library access). Granted
         on enabling the reliquary toggle, mirroring iOS.
         API 33+ uses READ_MEDIA_IMAGES; API 34+ also accepts the
         partial-access grant; pre-33 falls back to READ_EXTERNAL_STORAGE
         (scoped to <=32 to avoid Play's enhanced-storage review). -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />

    <!-- Android 11+ package visibility: required to bind the platform
         speech recognizer for voice intention dictation. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".PilgrimApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pilgrim.Splash"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Pilgrim">
            <!-- Stage 9-A: singleTop so widget-tap deep links re-enter
                 via onNewIntent instead of stacking a fresh MainActivity
                 instance.

                 iOS-parity icon switcher: MainActivity itself NO LONGER
                 carries the MAIN/LAUNCHER intent-filter — that lives on
                 the 9 `<activity-alias>` entries below. Exactly ONE
                 alias is enabled at a time; switching is implemented in
                 `IconSwitcher` via `PackageManager.setComponentEnabledSetting`.
                 The Default alias starts enabled. -->
        </activity>

        <!-- iOS parity `AboutView.swift:73-82@db4196e` — 9 alternate app
             icon aliases (Default + Dark + 7 guide-themed). All target
             MainActivity so user-tap routing is unchanged. Default is
             pre-enabled; the rest are `enabled="false"` and flipped at
             runtime via `IconSwitcher`. iOS exposes the matching guide
             alias via "Use as app icon" + Dark via "Use dark icon" +
             Default via "Reset to default". -->
        <activity-alias
            android:name=".IconDefault"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconDark"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_dark"
            android:roundIcon="@mipmap/ic_launcher_dark_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconBreeze"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_breeze"
            android:roundIcon="@mipmap/ic_launcher_breeze_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconDrift"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_drift"
            android:roundIcon="@mipmap/ic_launcher_drift_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconDusk"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_dusk"
            android:roundIcon="@mipmap/ic_launcher_dusk_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconEmber"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_ember"
            android:roundIcon="@mipmap/ic_launcher_ember_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconRiver"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_river"
            android:roundIcon="@mipmap/ic_launcher_river_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconSage"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_sage"
            android:roundIcon="@mipmap/ic_launcher_sage_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconStone"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_stone"
            android:roundIcon="@mipmap/ic_launcher_stone_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconConstellation"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_constellation"
            android:roundIcon="@mipmap/ic_launcher_constellation_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Stage 9-A: Glance widget receiver. The widget itself isn't
             @AndroidEntryPoint — the composable resolves Singletons
             via Hilt EntryPointAccessors at compose time. -->
        <receiver
            android:name=".widget.PilgrimWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_display_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/pilgrim_widget_info" />
        </receiver>

        <!-- Stage 9-A: day-rollover refresh is handled by a midnight-
             aligned WorkManager OneTimeWorkRequest that re-schedules
             itself on each run (see WidgetRefreshScheduler.scheduleMidnightRefresh).
             Manifest-registered ACTION_DATE_CHANGED / ACTION_TIME_SET
             receivers do NOT fire on API 26+ apps (implicit-broadcast
             blocklist). The Worker's persistence in WorkManager's
             database survives reboots. -->



        <service
            android:name=".service.WalkTrackingService"
            android:exported="false"
            android:foregroundServiceType="location"
            android:stopWithTask="true" />

        <!-- WorkManager is initialized via Configuration.Provider in
             PilgrimApp so its WorkerFactory can access Hilt-bound
             dependencies. The androidx.startup InitializationProvider
             would otherwise invoke WorkManagerInitializer with the
             default Configuration. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Stage 7-D: FileProvider for sharing etegami PNG postcards via
             ACTION_SEND. Authority = "${applicationId}.fileprovider"
             (must be stable — any receiving-app content URI grants key
             on this string). Backed by cache-path config in
             res/xml/file_paths.xml. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Stage 7-A: No Play Services Photo Picker backport is wired
             here. Activating the backport would require adding
             com.google.android.gms:play-services-picker and publishing
             the ModuleDependencies <service>. API 28-29 devices
             therefore fall back to SAF (ACTION_OPEN_DOCUMENT) — a
             file-browser UI rather than the photo grid, but
             functionally correct for picking an image. API 30+ uses
             the native Photo Picker directly. Re-evaluate wiring the
             backport in a later stage if API-28-29 usage is
             meaningful. -->

    </application>
</manifest>

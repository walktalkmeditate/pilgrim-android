<?xml version="1.0" encoding="utf-8"?>
<!--
SPDX-License-Identifier: GPL-3.0-or-later

Debug-only manifest fragment, merged ONLY into debug-variant builds
(never release — R12: the senses field report must not merely be
runtime-flagged, it must be absent from the shipped binary). Declares
the trigger for ThreadsFieldReport (core/threads, U9): a broadcast
receiver invoked via

  adb shell am broadcast -a org.walktalkmeditate.pilgrim.debug.RUN_SENSES_FIELD_REPORT

See ThreadsFieldReport.kt (src/debug/kotlin) for the harness itself.

Also the Honor desk harness (plan U19): mock locations for the Way
replayer, and its two adb triggers, one in the UI process and one in
:tracker beside the walk. HonorDebugReceiver.kt lists every command.

And the Honor links' App Links filter (plan U27), which moves to the main
manifest at the 2.0.0 flip; ReleaseBuildContentsTest proves release claims
no honor link until then.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Lint's MockLocation check flags this even here, the debug-only
         manifest it asks for; ReleaseBuildContentsTest proves release
         never requests it. -->
    <uses-permission
        android:name="android.permission.ACCESS_MOCK_LOCATION"
        tools:ignore="MockLocation" />

    <application>
        <!-- iOS associates only the honor host, every path
             (`applinks:honor.pilgrimapp.org`, the worker's `"/*"`): a path
             that doesn't parse opens the app and does nothing. The walk
             host is never claimed, so a tapped walk link opens the
             browser and imports only when pasted (AE4). -->
        <activity
            android:name="org.walktalkmeditate.pilgrim.MainActivity"
            android:exported="true">
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="honor.pilgrimapp.org" />
            </intent-filter>
        </activity>

        <receiver
            android:name="org.walktalkmeditate.pilgrim.core.threads.ThreadsFieldReportReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="org.walktalkmeditate.pilgrim.debug.RUN_SENSES_FIELD_REPORT" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="org.walktalkmeditate.pilgrim.debug.honor.HonorDebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="org.walktalkmeditate.pilgrim.debug.HONOR_LIST" />
                <action android:name="org.walktalkmeditate.pilgrim.debug.HONOR_BEGIN" />
                <action android:name="org.walktalkmeditate.pilgrim.debug.HONOR_EXPORT_GPX" />
                <action android:name="org.walktalkmeditate.pilgrim.debug.HONOR_DUMP" />
                <action android:name="org.walktalkmeditate.pilgrim.debug.HONOR_COMMAND" />
                <action android:name="org.walktalkmeditate.pilgrim.debug.HONOR_TILES_CLEAR_CACHE" />
                <action android:name="org.walktalkmeditate.pilgrim.debug.HONOR_TILES_REPORT" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="org.walktalkmeditate.pilgrim.debug.honor.HonorReplayReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:process=":tracker">
            <intent-filter>
                <action android:name="org.walktalkmeditate.pilgrim.debug.HONOR_REPLAY_START" />
                <action android:name="org.walktalkmeditate.pilgrim.debug.HONOR_REPLAY_STOP" />
            </intent-filter>
        </receiver>
    </application>

</manifest>

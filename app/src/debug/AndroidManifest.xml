<?xml version="1.0" encoding="utf-8"?>
<!--
SPDX-License-Identifier: GPL-3.0-or-later

Debug-only manifest fragment, merged ONLY into debug-variant builds
(never release — R12: the senses field report must not merely be
runtime-flagged, it must be absent from the shipped binary). Declares
the trigger for ThreadsFieldReport (core/threads, U9): a broadcast
receiver invoked via

  adb shell am broadcast -a org.walktalkmeditate.pilgrim.debug.RUN_SENSES_FIELD_REPORT

See ThreadsFieldReport.kt (src/debug/kotlin) for the harness itself.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <receiver
            android:name="org.walktalkmeditate.pilgrim.core.threads.ThreadsFieldReportReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="org.walktalkmeditate.pilgrim.debug.RUN_SENSES_FIELD_REPORT" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
